# EditorConfig - https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = crlf
trim_trailing_whitespace = true
insert_final_newline = false

[*.{cs,csproj,sln}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false